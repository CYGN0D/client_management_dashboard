# ==============================================================================
# CLIENTO — ENVIRONMENT CONFIGURATION EXAMPLE (.env.example)
# Copy this file to .env and adjust values for your environment:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# APPLICATION SETTINGS
# ------------------------------------------------------------------------------
APP_ENV=development                  # 'development' (detailed logs) or 'production' (concealed errors)
APP_NAME="Cliento"                   # Brand / application name
APP_URL=http://localhost:3000        # Web root URL for CORS and assets
APP_TIMEZONE=Asia/Kolkata            # Standard timezone (e.g. Asia/Kolkata, UTC, America/New_York)

# ------------------------------------------------------------------------------
# DATABASE CONNECTION (SQLite or MySQL)
# ------------------------------------------------------------------------------
# Set to 'sqlite' for zero-setup local .db file; set to 'mysql' for MySQL 8.0+
DB_CONNECTION=sqlite

# SQLite Configuration (Used when DB_CONNECTION=sqlite)
DB_DATABASE=database/cliento.db      # Local SQLite database file path

# MySQL Configuration (Used when DB_CONNECTION=mysql)
DB_HOST=127.0.0.1                    # MySQL host
DB_PORT=3306                         # MySQL port
DB_NAME=cliento_db                   # MySQL database name
DB_USER=cliento_user                 # MySQL database user
DB_PASS=ClientoSecure@2026           # MySQL database password

# ------------------------------------------------------------------------------
# SESSION & SECURITY
# ------------------------------------------------------------------------------
SESSION_NAME=CLIENTO_SESSID          # Custom session cookie name
SESSION_LIFETIME=604800              # Session expiration in seconds (604800 = 7 days)
SESSION_SECURE=false                 # Set to 'true' in production with HTTPS enabled

# ------------------------------------------------------------------------------
# DEFAULT SEED CREDENTIALS (for initial setup)
# ------------------------------------------------------------------------------
# Default admin user created by seed:
# Email:    admin@cliento.com
# Password: admin123
